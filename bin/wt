#!/usr/bin/env python3
"""wt — Workato Toolbox: Developer API capabilities that AIRO MCP and the
Workato Dev CLI don't expose (manifests, packages, recipe lifecycle, job
rerun/cancel, lookup-table row writes, connections CRUD, project properties).

Auth: WORKATO_API_TOKEN env var, else the macOS keychain entry the
workato-platform-cli stores (service `workato-platform-cli`, account =
profile name). Profile/region from ~/.workato/profiles.

Examples:
  wt api GET /api/users/me
  wt recipes start 74094657
  wt recipes force-run 74094657
  wt jobs repeat 74094657 --ids job1,job2
  wt manifests assets 30275122
  wt manifests create --file m.json
      (payload: {"export_manifest": {"name": ..., "assets": [...]}})
  wt packages export 356201 --out hr.zip
  wt packages import hr.zip 30275122 --restart-recipes
  wt properties upsert --file props.json
  wt lookup add-row <table_id> --data '{"Name":"x"}'
"""

import argparse
import re
import json
import os
import subprocess
import time
import sys
import urllib.error
import urllib.parse
import urllib.request

PROFILES_PATH = os.path.expanduser("~/.workato/profiles")
KEYCHAIN_SERVICE = "workato-platform-cli"


def load_profile(name):
    with open(PROFILES_PATH) as f:
        cfg = json.load(f)
    profiles = cfg.get("profiles", {})
    if not name:
        name = cfg.get("current_profile")
    p = profiles.get(name)
    if not p:
        die(f"profile '{name}' not found in {PROFILES_PATH}")
    return name, p


def keychain_token(profile):
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
             "-a", profile, "-w"],
            capture_output=True, text=True, check=True)
        return out.stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def die(msg, code=1):
    print(f"wt: {msg}", file=sys.stderr)
    sys.exit(code)


def client(args):
    # Profile resolution: explicit --profile wins, then WORKATO_PROFILE (set by
    # the wt-prod wrapper so every subcommand can target prod without worrying
    # about per-subcommand flag placement), then current_profile from the file.
    requested = getattr(args, "profile", None) or os.environ.get("WORKATO_PROFILE")
    profile, p = load_profile(requested)
    host = p.get("region_url", "https://www.workato.com").rstrip("/")
    # Safety: an explicitly targeted profile means the caller means THAT
    # environment. The ambient WORKATO_API_TOKEN belongs to whatever profile is
    # exported (usually dev), so the named profile's keychain token must win —
    # otherwise a prod invocation would silently run as dev. Env is only a
    # fallback when the profile has no keychain entry.
    if requested:
        token = keychain_token(profile) or os.environ.get("WORKATO_API_TOKEN")
    else:
        token = os.environ.get("WORKATO_API_TOKEN") or keychain_token(profile)
    if not token:
        die(f"no API token: set WORKATO_API_TOKEN or store one via "
            f"'workato profiles' (keychain service '{KEYCHAIN_SERVICE}')")
    if str(p.get("environment", "")).lower() == "production":
        print(f"⚠️  wt: PRODUCTION instance — {p.get('label', profile)} "
              f"(workspace {p.get('workspace_id')}). Writes require confirmation.",
              file=sys.stderr)
    return host, token


def request(host, token, method, path, query=None, data=None, headers=None,
            raw_body=None, content_type=None):
    url = f"{host}{path}"
    if query:
        url += "?" + urllib.parse.urlencode(query, doseq=True)
    # Workato's WAF redirects python-urllib-looking requests (default UA +
    # Accept-Encoding: identity + no Accept) to the sign-in page on newer
    # API routes — even with a valid bearer token. Always send real headers.
    hdrs = {"Authorization": f"Bearer {token}",
            "User-Agent": "wt/1.0 (Workato Toolbox)",
            "Accept": "application/json"}
    if headers:
        hdrs.update(headers)
    body = None
    if raw_body is not None:
        body = raw_body
        if content_type:
            hdrs["Content-Type"] = content_type
    elif data is not None:
        if isinstance(data, str):
            # --data arrives as a raw string; re-encoding it as-is would put
            # a JSON string literal on the wire (double-encode). Parse once.
            try:
                data = json.loads(data)
            except json.JSONDecodeError as e:
                die(f"--data is not valid JSON: {e}")
        body = json.dumps(data).encode()
        hdrs["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=hdrs, method=method)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            payload = resp.read()
            ct = resp.headers.get("Content-Type", "")
            status = resp.status
    except urllib.error.HTTPError as e:
        payload = e.read()
        status = e.code
        try:
            err = json.dumps(json.loads(payload), indent=2)
        except Exception:
            err = payload.decode(errors="replace")
        print(f"HTTP {status}\n{err}", file=sys.stderr)
        sys.exit(1)
    if content_type == "application/octet-stream" or (
            "application/zip" in ct or "octet-stream" in ct):
        return status, payload
    if not payload:
        return status, {}
    try:
        return status, json.loads(payload)
    except json.JSONDecodeError:
        return status, payload.decode(errors="replace")


def emit(result, raw=False):
    if raw:
        print(json.dumps(result, separators=(",", ":")))
    else:
        print(json.dumps(result, indent=2, default=str))


def ids_arg(s):
    return [x for x in s.split(",") if x.strip()]


# ---------------------------------------------------------------- recipes ---

def cmd_recipes(a):
    host, token = client(a)
    rid = a.recipe_id
    r = {"start": ("PUT", f"/api/recipes/{rid}/start"),
         "stop": ("PUT", f"/api/recipes/{rid}/stop"),
         "get": ("GET", f"/api/recipes/{rid}"),
         "delete": ("DELETE", f"/api/recipes/{rid}"),
         "copy": ("POST", f"/api/recipes/{rid}/copy"),
         "force-run": ("POST", f"/api/recipes/{rid}/force_run"),
         "poll-now": ("POST", f"/api/recipes/{rid}/poll_now"),
         "reset-trigger": ("POST", f"/api/recipes/{rid}/reset_trigger"),
         "versions": ("GET", f"/api/recipes/{rid}/versions"),
         "health": ("GET", f"/api/recipes/{rid}/health"),
         "health-scan": ("POST", f"/api/recipes/{rid}/health"),
         "job-counts": ("GET", "/api/recipes/job_counts"),
         "connect": ("PUT", f"/api/recipes/{rid}/connect")}[a.op]
    method, path = r
    query = {}
    data = None
    if a.op == "job-counts":
        query["recipe_ids[]"] = ids_arg(a.ids) if a.ids else []
        if a.updated_after:
            query["updated_after"] = a.updated_after
    elif a.op == "copy":
        data = a.body or {}
        if a.name:
            data["recipe"] = {"name": a.name}
    elif a.op in ("connect", "delete", "force-run"):
        data = a.body or None
    status, result = request(host, token, method, path, query=query, data=data)
    emit(result, a.raw)


# -------------------------------------------------------------------- jobs ---

def cmd_jobs(a):
    host, token = client(a)
    if a.op in ("repeat", "cancel"):
        path = (f"/api/recipes/{a.recipe_id}/repeat_jobs" if a.op == "repeat"
                else f"/api/recipes/{a.recipe_id}/cancel_jobs")
        status, result = request(host, token, "POST", path,
                                 data={"job_ids": ids_arg(a.ids)})
    elif a.op == "get":
        status, result = request(
            host, token, "GET",
            f"/api/recipes/{a.recipe_id}/jobs/{a.job_id}")
    else:  # list
        query = {}
        if a.status:
            query["status"] = a.status
        if a.offset:
            query["offset_job_id"] = a.offset
        if a.prev:
            query["prev"] = "true"
        if a.rerun_only:
            query["rerun_only"] = "true"
        status, result = request(host, token, "GET",
                                 f"/api/recipes/{a.recipe_id}/jobs",
                                 query=query)
    emit(result, a.raw)


# ------------------------------------------------------------- connections ---

def cmd_connections(a):
    host, token = client(a)
    if a.op == "list":
        query = {}
        if a.folder:
            query["folder_id"] = a.folder
        if a.project:
            query["project_id"] = a.project
        if a.runtime:
            query["include_runtime_connections"] = "true"
        if a.updated_after:
            query["updated_after"] = a.updated_after
        status, result = request(host, token, "GET", "/api/connections",
                                 query=query)
    elif a.op == "create":
        status, result = request(host, token, "POST", "/api/connections",
                                 data=a.body)
    elif a.op == "update":
        status, result = request(host, token, "PUT",
                                 f"/api/connections/{a.connection_id}",
                                 data=a.body)
    elif a.op == "delete":
        status, result = request(host, token, "DELETE",
                                 f"/api/connections/{a.connection_id}")
    elif a.op == "disconnect":
        status, result = request(host, token, "POST",
                                 f"/api/connections/{a.connection_id}/disconnect")
    elif a.op == "picklist":
        data = {"pick_list_name": a.pick_list_name}
        if a.params:
            data["pick_list_params"] = a.params
        status, result = request(host, token, "POST",
                                 f"/api/connections/{a.connection_id}/pick_list",
                                 data=data)
    emit(result, a.raw)


# ------------------------------------------------------------ lookup tables ---

def cmd_lookup(a):
    host, token = client(a)
    tid = a.table_id
    if a.op == "list":
        status, result = request(host, token, "GET", "/api/lookup_tables")
    elif a.op == "create":
        data = {"name": a.name, "schema": a.schema}
        if a.project:
            data["project_id"] = a.project
        status, result = request(host, token, "POST", "/api/lookup_tables",
                                 data=data)
    elif a.op == "delete":
        status, result = request(host, token, "POST",
                                 "/api/lookup_tables/batch_delete",
                                 data={"lookup_table_ids": ids_arg(tid)})
    elif a.op == "rows":
        query = {}
        if a.page:
            query["page"] = a.page
        if a.per_page:
            query["per_page"] = a.per_page
        status, result = request(host, token, "GET",
                                 f"/api/lookup_tables/{tid}/rows", query=query)
    elif a.op == "get-row":
        status, result = request(host, token, "GET",
                                 f"/api/lookup_tables/{tid}/rows/{a.row_id}")
    elif a.op == "add-row":
        status, result = request(host, token, "POST",
                                 f"/api/lookup_tables/{tid}/rows", data=a.body)
    elif a.op == "update-row":
        status, result = request(host, token, "PUT",
                                 f"/api/lookup_tables/{tid}/rows/{a.row_id}",
                                 data=a.body)
    elif a.op == "delete-row":
        status, result = request(host, token, "DELETE",
                                 f"/api/lookup_tables/{tid}/rows/{a.row_id}")
    elif a.op == "find":
        query = {f"by[{k}]": v for k, v in (a.by or {}).items()}
        status, result = request(host, token, "GET",
                                 f"/api/lookup_tables/{tid}/lookup",
                                 query=query)
    emit(result, a.raw)


# -------------------------------------------------------------- properties ---

def cmd_properties(a):
    host, token = client(a)
    if a.op == "list":
        query = {"prefix": a.prefix if a.prefix is not None else ""}
        if a.project:
            query["project_id"] = a.project
        status, result = request(host, token, "GET", "/api/properties",
                                 query=query)
    else:  # upsert
        data = a.body
        if a.file:
            with open(a.file) as f:
                data = json.load(f)
        if not data:
            die("upsert requires --file or --data JSON")
        status, result = request(host, token, "POST", "/api/properties",
                                 data=data)
    emit(result, a.raw)


# --------------------------------------------------------- folders/projects ---

def cmd_folders(a):
    host, token = client(a)
    if a.op == "list":
        status, result = request(host, token, "GET", "/api/folders")
    elif a.op == "get":
        status, result = request(host, token, "GET",
                                 f"/api/folders/{a.folder_id}")
    elif a.op == "create":
        data = {"name": a.name}
        if a.parent:
            data["parent_id"] = a.parent
        status, result = request(host, token, "POST", "/api/folders",
                                 data=data)
    elif a.op == "update":
        data = {}
        if a.name:
            data["name"] = a.name
        if a.parent:
            data["parent_id"] = a.parent
        status, result = request(host, token, "PUT",
                                 f"/api/folders/{a.folder_id}", data=data)
    elif a.op == "delete":
        status, result = request(host, token, "DELETE",
                                 f"/api/folders/{a.folder_id}")
    emit(result, a.raw)


def cmd_projects(a):
    host, token = client(a)
    if a.op == "list":
        status, result = request(host, token, "GET", "/api/projects")
    elif a.op == "update":
        data = {}
        if a.name:
            data["name"] = a.name
        status, result = request(host, token, "PUT",
                                 f"/api/projects/{a.project_id}", data=data)
    elif a.op == "delete":
        status, result = request(host, token, "DELETE",
                                 f"/api/projects/{a.project_id}")
    emit(result, a.raw)


# --------------------------------------------- manifests & packages (RM) ---

def cmd_manifests(a):
    host, token = client(a)
    if a.op == "assets":
        query = {}
        if a.include_all:
            query["include_all"] = "true"
        status, result = request(host, token, "GET",
                                 "/api/export_manifests/folder_assets",
                                 query=query)
    elif a.op == "get":
        status, result = request(host, token, "GET",
                                 f"/api/export_manifests/{a.manifest_id}")
    elif a.op == "create":
        data = a.body
        if a.file:
            with open(a.file) as f:
                data = json.load(f)
        if not data:
            die("create requires --file or --data JSON")
        if isinstance(data, dict) and "export_manifest" not in data:
            data = {"export_manifest": data}
        status, result = request(host, token, "POST", "/api/export_manifests",
                                 data=data)
    elif a.op == "update":
        data = a.body
        if a.file:
            with open(a.file) as f:
                data = json.load(f)
        if isinstance(data, dict) and "export_manifest" not in data:
            data = {"export_manifest": data}
        status, result = request(host, token, "PUT",
                                 f"/api/export_manifests/{a.manifest_id}",
                                 data=data)
    elif a.op == "delete":
        status, result = request(host, token, "DELETE",
                                 f"/api/export_manifests/{a.manifest_id}")
    emit(result, a.raw)


def cmd_packages(a):
    host, token = client(a)
    if a.op == "export":
        data = a.body or {}
        status, result = request(
            host, token, "POST", f"/api/packages/export/{a.id}",
            data=data)
        emit(result, a.raw)
    elif a.op == "import":
        query = {}
        if a.restart_recipes:
            query["restart_recipes"] = "true"
        if a.include_tags:
            query["include_tags"] = "true"
        with open(a.zipfile, "rb") as f:
            payload = f.read()
        status, result = request(host, token, "POST",
                                 f"/api/packages/import/{a.id}",
                                 query=query, raw_body=payload,
                                 content_type="application/octet-stream")
        emit(result, a.raw)
    elif a.op == "get":
        status, result = request(host, token, "GET",
                                 f"/api/packages/{a.id}")
        emit(result, a.raw)
    elif a.op == "download":
        status, payload = request(host, token, "GET",
                                  f"/api/packages/{a.id}/download")
        dest = a.out or f"package-{a.id}.zip"
        with open(dest, "wb") as f:
            f.write(payload)
        print(f"saved {dest} ({len(payload)} bytes)")


# --------------------------------------------------------------- data tables ---
# Record manipulation APIs live on a separate host: data-tables.workato.com.
# Neither AIRO (its data_table_query route 404s here) nor the dev CLI nor
# www.workato.com/api expose row access.

DT_HOST = "https://data-tables.workato.com"


def dt_record_body(body):
    """Data-tables records API expects {"document": {<col>: value}}, not a
    flat column map. Accept --data/--file flat JSON and add the envelope."""
    if isinstance(body, str):
        try:
            body = json.loads(body)
        except json.JSONDecodeError as e:
            die(f"--data is not valid JSON: {e}")
    if isinstance(body, dict) and "document" not in body:
        return {"document": body}
    return body


def cmd_dt(a):
    host, token = client(a)
    tid = a.table_id
    if a.op == "query":
        body = {"limit": a.limit}
        if a.where:
            body["where"] = dict(kv.split("=", 1) for kv in a.where.split(","))
        if a.order:
            body["order"] = a.order
        if a.select:
            body["select"] = ids_arg(a.select)
        if a.timezone_offset is not None:
            body["timezone_offset_secs"] = a.timezone_offset
        if a.continuation:
            body["continuation_token"] = a.continuation
        status, result = request(
            DT_HOST, token, "POST", f"/api/v1/tables/{tid}/query", data=body)
        schema = result.get("schema") or []
        names = [f["name"] for f in (schema[1] if len(schema) > 1 else [])]
        sysnames = ["$record_id", "$created_at", "$updated_at"]
        data = result.get("data") or []
        if a.raw or not data:
            emit(result, a.raw)
            return
        mapped = [dict(zip(sysnames, row[0])) | dict(zip(names, row[1]))
                  for row in data]
        out = {"count": result.get("count"), "rows": mapped}
        if result.get("continuation_token"):
            out["continuation_token"] = result["continuation_token"]
        emit(out, a.raw)
    elif a.op == "get":
        status, result = request(host, token, "GET", f"/api/data_tables/{tid}")
        emit(result, a.raw)
    elif a.op == "list":
        query = {}
        if a.page:
            query["page"] = a.page
        if a.per_page:
            query["per_page"] = a.per_page
        status, result = request(host, token, "GET", "/api/data_tables",
                                 query=query)
        emit(result, a.raw)
    elif a.op == "get-record":
        status, result = request(DT_HOST, token, "GET",
                                 f"/api/v1/tables/{tid}/records/{a.record_id}")
        emit(result, a.raw)
    elif a.op == "create-record":
        status, result = request(DT_HOST, token, "POST",
                                 f"/api/v1/tables/{tid}/records",
                                 data=dt_record_body(a.body))
        emit(result, a.raw)
    elif a.op == "update-record":
        status, result = request(DT_HOST, token, "PUT",
                                 f"/api/v1/tables/{tid}/records/{a.record_id}",
                                 data=dt_record_body(a.body))
        emit(result, a.raw)
    elif a.op == "delete-record":
        status, result = request(DT_HOST, token, "DELETE",
                                 f"/api/v1/tables/{tid}/records/{a.record_id}")
        emit(result, a.raw)
    elif a.op == "truncate":
        status, result = request(host, token, "POST",
                                 f"/api/data_tables/{tid}/truncate", data={})
        emit(result, a.raw)


# ---------------------------------------------------------- API platform ---

def cmd_apic(a):
    host, token = client(a)
    if a.op == "collections":
        status, result = request(host, token, "GET", "/api/api_collections")
    elif a.op == "endpoints":
        status, result = request(host, token, "GET", "/api/api_endpoints")
    else:  # enable
        data = a.body or {}
        if a.collection:
            data["collection_id"] = a.collection
        status, result = request(host, token, "POST",
                                 "/api/api_endpoints/enable", data=data)
    emit(result, a.raw)


# ------------------------------------------------------------ passthrough ---

def cmd_api(a):
    host, token = client(a)
    query = {}
    for kv in a.query or []:
        k, _, v = kv.partition("=")
        query[k] = v
    data = None
    if a.data:
        data = json.loads(a.data)
    status, result = request(host, token, a.method.upper(), a.path,
                             query=query, data=data)
    emit(result, a.raw)


# ------------------------------------------------------------------ parser ---

def add_common(p):
    p.add_argument("--profile", help="Workato CLI profile (default: current)")
    p.add_argument("--raw", action="store_true",
                   help="compact JSON output")


def add_json_body(p):
    p.add_argument("--data", dest="body", help="JSON request body (string)")


def cmd_testcases(a):
    """Test Automation API: run test cases by manifest/project/folder/recipe,
    then poll the run request by id."""
    host, token = client(a)
    if a.op == "run":
        body = {}
        if a.manifest: body["manifest_id"] = a.manifest
        if a.project: body["project_id"] = a.project
        if a.folder: body["folder_id"] = a.folder
        if a.recipe: body["recipe_id"] = a.recipe
        if a.ids: body["test_case_ids"] = [x for x in a.ids.split(",") if x]
        if len(body) != 1:
            die("choose exactly one scope: --manifest | --project | --folder | --recipe | --ids")
        out = request(host, token, "POST",
                      "/api/test_cases/run_requests", data=body)
        print(json.dumps(out, indent=2))
    elif a.op == "status":
        out = request(host, token, "GET",
                      f"/api/test_cases/run_requests/{a.run_id}")
        print(json.dumps(out, indent=2))
    elif a.op == "cases":
        out = request(host, token, "GET",
                      f"/api/recipes/{a.recipe}/test_cases")
        print(json.dumps(out, indent=2))

# ---------------------------------------------------------------- fixtures ---

FIXTURE_DIR = os.path.expanduser("~/.claude/knowledge/fixtures")


def _fx_call(host, token, method, url, payload=None, authed=True):
    """Non-dying request for the fixture harness: HTTP errors become
    verdicts, not exits (wt.request sys.exits on HTTPError)."""
    hdrs = {"Accept": "application/json"}
    if authed:
        hdrs["Authorization"] = f"Bearer {token}"
        hdrs["User-Agent"] = "wt/1.0 (Workato Toolbox)"
    data = None
    if payload is not None:
        data = json.dumps(payload).encode()
        hdrs["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            body = resp.read()
            try:
                return resp.status, json.loads(body or b"{}")
            except json.JSONDecodeError:
                return resp.status, body.decode(errors="replace")[:500]
    except urllib.error.HTTPError as e:
        body = e.read()
        try:
            return e.code, json.loads(body or b"{}")
        except json.JSONDecodeError:
            return e.code, body.decode(errors="replace")[:500]
    except Exception as e:  # noqa: BLE001 — any transport failure is a verdict
        return 0, {"transport_error": str(e)}


def _fx_get_path(obj, dotted):
    cur = obj
    for part in dotted.split("."):
        if isinstance(cur, dict):
            if part not in cur:
                return None, f"path '{dotted}': missing key '{part}'"
            cur = cur[part]
        elif isinstance(cur, list) and part.isdigit():
            i = int(part)
            if i >= len(cur):
                return None, f"path '{dotted}': index {i} out of range"
            cur = cur[i]
        else:
            return None, f"path '{dotted}': cannot descend into {type(cur).__name__}"
    return cur, None


def _fx_check(expect, output):
    """expect: {'path': 'a.b', 'op': 'eq', 'value': x}. Returns (ok, note)."""
    path, op = expect.get("path", ""), expect.get("op", "present")
    val, err = _fx_get_path(output, path)
    if err:
        return False, err
    want = expect.get("value")
    if op == "present":
        return val is not None, f"{path} present={val is not None}"
    if op == "absent":
        return val is None, f"{path} absent={val is None}"
    if op == "eq":
        return val == want, f"{path}={val!r} == {want!r}: {val == want}"
    if op == "ne":
        return val != want, f"{path}={val!r} != {want!r}: {val != want}"
    if op == "contains":
        ok = want in val if isinstance(val, (list, str, dict)) else False
        return ok, f"{path} contains {want!r}: {ok}"
    if op in ("gt", "lt"):
        try:
            ok = (float(val) > float(want)) if op == "gt" else (float(val) < float(want))
            return ok, f"{path}={val} {op} {want}: {ok}"
        except (TypeError, ValueError):
            return False, f"{path}={val!r} not numeric for {op}"
    return False, f"unknown op {op}"


def cmd_fixture(a):
    """Browser-free recipe testing: invoke the recipe the way a real caller
    would (webhook POST / API endpoint / force_run), catch the new job, and
    assert on its output. Fixtures: ~/.claude/knowledge/fixtures/<recipe>.json
    {recipe_id, kind, webhook_url?, api_url?, input?, expect?: [{path, op, value}]}
    Scheduled-recipe pattern: lift the body into a recipe function, keep the
    schedule as a thin shell, and fixture-test a callable driver recipe."""
    host, token = client(a)
    fpath = os.path.expanduser(a.fixture) if (a.fixture and "/" in a.fixture) \
        else os.path.join(FIXTURE_DIR, f"{a.recipe}.json")

    if a.op == "init":
        os.makedirs(FIXTURE_DIR, exist_ok=True)
        if os.path.exists(fpath) and not a.fixture:
            die(f"fixture exists: {fpath} (pass --fixture to override)")
        fx = {"recipe_id": a.recipe, "kind": a.kind or "webhook",
              "webhook_url": "", "input": {}, "expect": []}
        json.dump(fx, open(fpath, "w"), indent=1)
        print(f"scaffolded {fpath} — fill kind/webhook_url/input/expect, then `wt fixture run --recipe {a.recipe}`")
        return

    if a.op == "list":
        if not os.path.isdir(FIXTURE_DIR):
            print("no fixtures yet")
            return
        for f in sorted(os.listdir(FIXTURE_DIR)):
            try:
                fx = json.load(open(os.path.join(FIXTURE_DIR, f)))
                print(f"{f:24} kind={fx.get('kind', '?'):9} expects={len(fx.get('expect', []))}")
            except (json.JSONDecodeError, OSError) as e:
                print(f"{f:24} UNREADABLE {e}")
        return

    # ---- run ----
    if not a.recipe:
        die("run needs --recipe")
    fx = {}
    if os.path.exists(fpath):
        fx = json.load(open(fpath))
    kind = a.kind or fx.get("kind")
    expect = list(fx.get("expect", []))
    for spec in (a.expect or []):
        path, _, rest = spec.partition("=")
        op, _, val = rest.partition(":")
        e = {"path": path, "op": op or "present"}
        if op in ("eq", "ne", "contains", "gt", "lt"):
            try:
                e["value"] = json.loads(val)
            except json.JSONDecodeError:
                e["value"] = val
        expect.append(e)

    # 0. capture the newest job id before invoking
    st, before = _fx_call(host, token, "GET",
                          f"{host}/api/recipes/{a.recipe}/jobs?per_page=1")
    prev_id = ((before.get("items") or [{}])[0].get("id")
               if isinstance(before, dict) else None)

    # 1. invoke
    payload = json.loads(a.input) if a.input else fx.get("input")
    if kind == "webhook":
        url = fx.get("webhook_url") or fx.get("api_url")
        if not url:
            die("webhook kind needs fixture webhook_url (from the recipe trigger's Request URL)")
        st, resp = _fx_call(host, token, "POST", url, payload=payload, authed=False)
    elif kind == "api":
        url = fx.get("api_url")
        if not url:
            die("api kind needs fixture api_url (the API platform endpoint URL)")
        st, resp = _fx_call(host, token, "POST", url, payload=payload, authed=False)
    elif kind == "force-run":
        st, resp = _fx_call(host, token, "POST",
                            f"{host}/api/recipes/{a.recipe}/force_run",
                            payload=payload)
    else:
        die(f"unknown kind {kind!r}")
    invoke_ok = 200 <= st < 300
    result = {"recipe_id": a.recipe, "kind": kind, "invoke_status": st}

    # 2. catch the new job
    job = None
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        st2, jobs = _fx_call(host, token, "GET",
                             f"{host}/api/recipes/{a.recipe}/jobs?per_page=1")
        items = jobs.get("items") or [] if isinstance(jobs, dict) else []
        if items and items[0].get("id") != prev_id:
            job = items[0]
            break
        time.sleep(3)
    if not job:
        result.update({"verdict": "timeout", "invoke_response": resp,
                       "note": f"no new job within {a.timeout}s"})
        print(json.dumps(result, indent=2))
        sys.exit(2)
    result["job_id"] = job.get("id")
    result["job_status"] = job.get("status")

    # 3. pull the job output — function recipes expose job 'output'; other
    # recipes: fall back to the LAST STEP's output in the trace
    st3, detail = _fx_call(host, token, "GET",
                           f"{host}/api/recipes/{a.recipe}/jobs/{job.get('id')}")
    output = detail.get("output") if isinstance(detail, dict) else None
    if not output and isinstance(detail, dict) and detail.get("lines"):
        last = detail["lines"][-1]
        output = last.get("output")
        if output is None:
            output = {"step_output": None,
                      "step": last.get("recipe_line_number"),
                      "adapter": last.get("adapter_name")}
    result["output"] = output if output is not None else detail

    # 4. assertions
    failures = []
    if not invoke_ok:
        failures.append(f"invoke returned HTTP {st}")
    if job.get("status") not in ("succeeded", "success"):
        failures.append(f"job status {job.get('status')!r}")
    for e in expect:
        ok, note = _fx_check(e, output)
        (result.setdefault("checks", []).append(
            {"path": e["path"], "op": e["op"], "ok": ok, "note": note}))
        if not ok:
            failures.append(note)
    result["verdict"] = "fail" if failures else "pass"
    if failures:
        result["failures"] = failures
        print(json.dumps(result, indent=2))
        sys.exit(1)
    print(json.dumps(result, indent=2))


def cmd_discover(a):
    """Self-discover the Workato Developer API surface and report coverage."""
    host, token = client(a)
    script = os.path.expanduser(
        "~/.claude/knowledge/scripts/workato-api-discover.py")
    if not os.path.exists(script):
        die(f"discovery script not found: {script}")
    args = ["python3", script]
    if a.refresh:
        args.append("--refresh")
    r = subprocess.run(args, capture_output=True, text=True)
    if r.stdout:
        print(r.stdout, end="" if r.stdout.endswith("\n") else "\n")
    if r.returncode != 0:
        print(r.stderr, file=sys.stderr)
def main():
    ap = argparse.ArgumentParser(prog="wt", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="group", required=True)

    # raw passthrough
    p = sub.add_parser("api", help="raw Developer API passthrough")
    add_common(p)
    p.add_argument("method", help="HTTP method")
    p.add_argument("path", help="resource path, e.g. /api/users/me")
    p.add_argument("--query", nargs="*", help="k=v query params")
    p.add_argument("--data", dest="data", help="JSON request body")
    p.set_defaults(fn=cmd_api)

    p = sub.add_parser("recipes", help="recipe lifecycle")
    add_common(p)
    p.add_argument("op", choices=["start", "stop", "get", "delete", "copy",
                                  "force-run", "poll-now", "reset-trigger",
                                  "versions", "health", "health-scan",
                                  "job-counts", "connect"])
    p.add_argument("recipe_id", nargs="?", help="recipe ID")
    p.add_argument("--ids", help="comma-separated IDs (job-counts)")
    p.add_argument("--updated-after")
    p.add_argument("--name", help="name for copy")
    add_json_body(p)
    p.set_defaults(fn=cmd_recipes)

    p = sub.add_parser("jobs", help="job list / repeat / cancel")
    add_common(p)
    p.add_argument("op", choices=["list", "get", "repeat", "cancel"])
    p.add_argument("recipe_id", nargs="?", type=int)
    p.add_argument("job_id", nargs="?", help="job handle (get)")
    p.add_argument("--ids", help="comma-separated job IDs (repeat/cancel)")
    p.add_argument("--status", choices=["succeeded", "failed", "pending"])
    p.add_argument("--offset")
    p.add_argument("--prev", action="store_true")
    p.add_argument("--rerun-only", action="store_true")
    p.set_defaults(fn=cmd_jobs)

    p = sub.add_parser("connections", help="connection CRUD")
    add_common(p)
    p.add_argument("op", choices=["list", "create", "update", "delete",
                                  "disconnect", "picklist"])
    p.add_argument("connection_id", nargs="?", help="connection ID")
    p.add_argument("--folder", "--folder-id", dest="folder")
    p.add_argument("--project", "--project-id", dest="project")
    p.add_argument("--runtime", action="store_true",
                   help="include runtime user connections")
    p.add_argument("--updated-after")
    p.add_argument("--pick-list-name")
    p.add_argument("--params", help="JSON pick_list_params")
    add_json_body(p)
    p.set_defaults(fn=cmd_connections)

    p = sub.add_parser("lookup", help="lookup-table row CRUD")
    add_common(p)
    p.add_argument("op", choices=["list", "create", "delete", "rows",
                                  "get-row", "add-row", "update-row",
                                  "delete-row", "find"])
    p.add_argument("table_id", nargs="?", help="lookup table ID")
    p.add_argument("row_id", nargs="?")
    p.add_argument("--name", help="table name (create)")
    p.add_argument("--schema", help="JSON schema (create)")
    p.add_argument("--project", type=int)
    p.add_argument("--page", type=int)
    p.add_argument("--per-page", type=int)
    p.add_argument("--by", help="k=v lookup criteria (find), comma-separated")
    add_json_body(p)
    p.set_defaults(fn=cmd_lookup)

    p = sub.add_parser("properties", help="project properties list/upsert")
    add_common(p)
    p.add_argument("op", choices=["list", "upsert"])
    p.add_argument("--prefix")
    p.add_argument("--project", type=int)
    p.add_argument("--file", help="JSON file with property payload")
    add_json_body(p)
    p.set_defaults(fn=cmd_properties)

    p = sub.add_parser("folders", help="folder CRUD")
    add_common(p)
    p.add_argument("op", choices=["list", "get", "create", "update", "delete"])
    p.add_argument("folder_id", nargs="?", type=int)
    p.add_argument("--name")
    p.add_argument("--parent", type=int)
    p.set_defaults(fn=cmd_folders)

    p = sub.add_parser("projects", help="project list/update/delete")
    add_common(p)
    p.add_argument("op", choices=["list", "update", "delete"])
    p.add_argument("project_id", nargs="?", type=int)
    p.add_argument("--name")
    p.set_defaults(fn=cmd_projects)

    p = sub.add_parser("manifests", help="export manifest management")
    add_common(p)
    p.add_argument("op", choices=["assets", "get", "create",
                                  "update", "delete"])
    p.add_argument("manifest_id", nargs="?", type=int)
    p.add_argument("--folder", type=int,
                   help="folder ID (assets: view folder's assets)")
    p.add_argument("--include-all", action="store_true")
    p.add_argument("--file", help="JSON file with manifest payload")
    add_json_body(p)
    p.set_defaults(fn=cmd_manifests)

    p = sub.add_parser("packages", help="package export / import")
    add_common(p)
    p.add_argument("op", choices=["export", "import", "get", "download"])
    p.add_argument("id", nargs="?", type=int,
                   help="manifest ID (export) / folder ID (import) / package ID")
    p.add_argument("--zipfile", help="zip file path (import)")
    p.add_argument("--out", help="destination path (download)")
    p.add_argument("--restart-recipes", action="store_true",
                   help="allow restarting running recipes on import")
    p.add_argument("--include-tags", action="store_true")
    add_json_body(p)
    p.set_defaults(fn=cmd_packages)

    p = sub.add_parser("dt", help="data-table records: query/CRUD (records API)")
    add_common(p)
    p.add_argument("op", choices=["query", "list", "get", "get-record",
                                  "create-record", "update-record",
                                  "delete-record", "truncate"])
    p.add_argument("table_id", help="table UUID or numeric ID (list/get ops)")
    p.add_argument("record_id", nargs="?")
    p.add_argument("--where", help="col=val,col2=val2 (equality filters)")
    p.add_argument("--order", help="column to sort by, e.g. $created_at")
    p.add_argument("--select", help="comma-separated columns to return")
    p.add_argument("--limit", type=int, default=20, help="max rows (max 200)")
    p.add_argument("--timezone-offset", type=int, default=0,
                   dest="timezone_offset",
                   help="offset secs for date-time filters (required on date cols)")
    p.add_argument("--continuation", help="continuation token from prior page")
    add_json_body(p)
    p.set_defaults(fn=cmd_dt)

    p = sub.add_parser("apic", help="API platform collections/endpoints")
    add_common(p)
    p.add_argument("op", choices=["collections", "endpoints", "enable"])
    p.add_argument("--collection", type=int)
    add_json_body(p)
    p.set_defaults(fn=cmd_apic)

    p = sub.add_parser("discover", help="self-discover the Developer API surface; coverage + gap report")
    p.add_argument("--refresh", action="store_true",
                   help="re-harvest the endpoint index from Workato docs")
    p.set_defaults(fn=cmd_discover)

    p = sub.add_parser("testcases", help="Test Automation API: run/poll recipe test cases")
    add_common(p)
    p.add_argument("op", choices=["run", "status", "cases"])
    p.add_argument("--manifest", type=int)
    p.add_argument("--project", type=int)
    p.add_argument("--folder", type=int)
    p.add_argument("--recipe", type=int)
    p.add_argument("--ids", help="comma-separated test case ids")
    p.add_argument("--run-id", help="run request id, for op=status")
    p.set_defaults(fn=cmd_testcases)

    p = sub.add_parser("fixture", help="browser-free recipe testing: invoke via webhook/API/force-run, assert on the job output")
    add_common(p)
    p.add_argument("op", choices=["init", "list", "run"])
    p.add_argument("--recipe", type=int, help="recipe id the fixture tests")
    p.add_argument("--kind", choices=["webhook", "force-run", "api"],
                   help="invocation kind: webhook = POST to trigger URL (payload = --input or fixture input); force-run = POST /force_run (scheduled recipes); api = POST to an API-platform endpoint URL")
    p.add_argument("--fixture", help="fixture name or explicit path (default: ~/.claude/knowledge/fixtures/<recipe>.json)")
    p.add_argument("--input", help="JSON payload for this run (overrides fixture input)")
    p.add_argument("--expect", nargs="*", help="inline assertions path=op:value (ops: eq, ne, present, absent, contains, gt, lt); merged over fixture expects")
    p.add_argument("--timeout", type=int, default=90, help="seconds to wait for the new job")
    p.set_defaults(fn=cmd_fixture)

    args = ap.parse_args()
    # small post-parse normalizations
    if getattr(args, "by", None):
        args.by = dict(kv.split("=", 1) for kv in args.by.split(","))
    if getattr(args, "params", None):
        args.params = json.loads(args.params)
    if getattr(args, "schema", None):
        args.schema = json.loads(args.schema)
    if args.group == "connections" and args.op == "create" and not args.body \
            and not args.data:
        die("create requires --data JSON body")
    args.fn(args)


if __name__ == "__main__":
    main()
