#!/bin/bash
"$HOME/.local/bin/harness-backup" 2>&1 | tail -5
# heartbeat check-in so the dashboard chip shows ok (dream-nightly.sh pattern)
printf '{"ts":"%s","job":"harness-backup"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" | python3 /Users/YOUR-USER/.claude/knowledge/scripts/atomic_io.py /Users/YOUR-USER/.claude/knowledge/garden-reports/heartbeat.jsonl
