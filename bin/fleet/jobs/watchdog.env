CLAUDE_JOB=yes
# cwd assumption fix (2026-10-22, triage watchdog-dark-3-nights-cwd-fail):
# $HOME-expanded, never a literal absolute path — the 10-20 template-placeholder
# corruption (literal /Users/<NAME>/ render-never-applied) killed the watchdog
# cwd-fail two nights straight. run-job.sh additionally falls back to
# $HOME if this directory ever vanishes (job still runs; report still lands).
JOB_CWD="$HOME/orca/workspaces/workbench/Workday-Development"
TIMEOUT=1800
EXTRA_ARGS="--permission-mode bypassPermissions"
