<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.josh.harness-dreamer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{HOME}}/.claude/knowledge/scripts/dream-nightly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>43</integer></dict>
  <key>StandardOutPath</key><string>/tmp/harness-dreamer.log</string>
  <key>StandardErrorPath</key><string>/tmp/harness-dreamer.log</string>
</dict>
</plist>
